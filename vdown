#!/usr/bin/env bash
# ==============================================================================
# VDownloader CLI Executable Launcher
# Automatically manages Python virtualenv and runs main.py
# ==============================================================================

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

VENV_DIR="$SCRIPT_DIR/venv"
PYTHON_BIN="$VENV_DIR/bin/python3"
PIP_BIN="$VENV_DIR/bin/pip"

# Check if virtual environment exists; if not, initialize it automatically
if [ ! -f "$PYTHON_BIN" ]; then
    echo "Initializing virtual environment for VDownloader..."
    python3 -m venv "$VENV_DIR" || {
        echo "Error: Unable to create virtualenv. Please ensure python3-venv is installed."
        exit 1
    }
    echo "Installing required dependencies (yt-dlp, mutagen)..."
    "$PIP_BIN" install -q -r "$SCRIPT_DIR/requirements.txt" || {
        echo "Error: Failed to install required dependencies."
        exit 1
    }
    echo "Setup complete!"
fi

# Execute main downloader
exec "$PYTHON_BIN" "$SCRIPT_DIR/main.py" "$@"
