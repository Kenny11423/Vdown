#!/bin/sh
# ==============================================================================
# VDownloader CLI Executable Launcher
# Compatible with both Standard Linux and iSH (Alpine on iOS)
# ==============================================================================

# Resolve script directory (POSIX compliant, handles symlinks)
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SCRIPT_DIR=`dirname "$PRG"`
SCRIPT_DIR=`cd "$SCRIPT_DIR" && pwd`

VENV_PYTHON="$SCRIPT_DIR/venv/bin/python3"

# Determine Python executable
if [ -f "$VENV_PYTHON" ]; then
    PYTHON_EXEC="$VENV_PYTHON"
elif python3 -c "import yt_dlp" >/dev/null 2>&1; then
    PYTHON_EXEC="python3"
else
    echo "Initializing VDownloader dependencies..."
    if [ -f /etc/alpine-release ] || command -v apk >/dev/null 2>&1; then
        pip install --break-system-packages -q -r "$SCRIPT_DIR/requirements.txt" 2>/dev/null || {
            python3 -m venv "$SCRIPT_DIR/venv" && "$SCRIPT_DIR/venv/bin/pip" install -q -r "$SCRIPT_DIR/requirements.txt"
        }
    else
        python3 -m venv "$SCRIPT_DIR/venv" && "$SCRIPT_DIR/venv/bin/pip" install -q -r "$SCRIPT_DIR/requirements.txt"
    fi

    if [ -f "$VENV_PYTHON" ]; then
        PYTHON_EXEC="$VENV_PYTHON"
    else
        PYTHON_EXEC="python3"
    fi
fi

exec "$PYTHON_EXEC" "$SCRIPT_DIR/main.py" "$@"
